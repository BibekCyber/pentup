  anthropic: Boolean!
  gemini: Boolean!
  bedrock: Boolean!
  ollama: Boolean!
  custom: Boolean!
  deepseek: Boolean!
  glm: Boolean!
  kimi: Boolean!
  qwen: Boolean!
}

# Default provider configurations
