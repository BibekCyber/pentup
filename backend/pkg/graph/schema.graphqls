  bedrock: [ModelConfig!]
  ollama: [ModelConfig!]
  custom: [ModelConfig!]
  deepseek: [ModelConfig!]
  glm: [ModelConfig!]
  kimi: [ModelConfig!]
  qwen: [ModelConfig!]
}

