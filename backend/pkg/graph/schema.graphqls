  anthropic: ProviderConfig!
  gemini: ProviderConfig
  bedrock: ProviderConfig
  ollama: ProviderConfig
  custom: ProviderConfig
  deepseek: ProviderConfig
  glm: ProviderConfig
  kimi: ProviderConfig
  qwen: ProviderConfig
