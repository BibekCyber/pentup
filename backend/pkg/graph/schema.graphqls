# =================== API Tokens types ===================

enum TokenStatus {
  active
  revoked
  expired
}

type APIToken {
  id: ID!
  tokenId: String!
  userId: ID!
  roleId: ID!
  name: String
  ttl: Int!
  status: TokenStatus!
  createdAt: Time!
  updatedAt: Time!
}

type APITokenWithSecret {
  id: ID!
  tokenId: String!
  userId: ID!
  roleId: ID!
  name: String
  ttl: Int!
  status: TokenStatus!
  createdAt: Time!
  updatedAt: Time!
