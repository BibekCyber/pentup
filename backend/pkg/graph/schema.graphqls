scalar Time

# Core execution status for flows, tasks and agents
enum StatusType {
  created
  running
  waiting
  finished
  failed
}

# LLM provider types supported by PentAGI
enum ProviderType {
  openai
  anthropic
  gemini
  bedrock
  ollama
  custom
  deepseek
  glm
  kimi
  qwen
}

# Reasoning effort levels for advanced AI models (OpenAI format)
enum ReasoningEffort {
  high
  medium
  low
}

# Template types for AI agent prompts and system operations
enum PromptType {
  primary_agent
  assistant
  pentester
  question_pentester
  coder
  question_coder
  installer
  question_installer
  searcher
  question_searcher
  memorist
  question_memorist
  adviser
  question_adviser
  generator
  subtasks_generator
  refiner
  subtasks_refiner
  reporter
  task_reporter
  reflector
  question_reflector
  enricher
  question_enricher
  toolcall_fixer
  input_toolcall_fixer
  summarizer
  image_chooser
  language_chooser
  flow_descriptor
  task_descriptor
  execution_logs
  full_execution_context
  short_execution_context
  tool_call_id_collector
  tool_call_id_detector
  question_execution_monitor
  question_task_planner
  task_assignment_wrapper
}

# AI agent types for autonomous penetration testing
enum AgentType {
  primary_agent
  reporter
  generator
  refiner
  reflector
  enricher
  adviser
  coder
  memorist
  searcher
  installer
  pentester
  summarizer
  tool_call_fixer
  assistant
}

# AI agent type for provider configuration
enum AgentConfigType {
  simple
  simple_json
  primary_agent
  assistant
  generator
  refiner
  adviser
  reflector
  searcher
  enricher
  coder
  installer
  pentester
}

# Terminal output stream types
enum TerminalLogType {
  stdin
  stdout
  stderr
}

# Message types for agent communication and logging
enum MessageLogType {
  answer
  report
  thoughts
  browser
  terminal
  file
  search
  advice
  ask
  input
  done
}

# Output format types for responses
enum ResultFormat {
  plain
  markdown
  terminal
}

enum ResultType {
  success
  error
}

enum TerminalType {
  primary
  secondary
}

enum VectorStoreAction {
  retrieve
  store
}

# ==================== Core System Types ====================

type Settings {
  debug: Boolean!
  askUser: Boolean!
  dockerInside: Boolean!
  assistantUseAgents: Boolean!
}

# ==================== User Preferences Types ====================

type UserPreferences {
  id: ID!
  favoriteFlows: [ID!]!
}

# ==================== Flow Template Types ====================

enum TargetType {
  web_app
  api
  aws
  azure
  gcp
  cloud
  network
  mobile_backend
  general
}

type FlowTemplate {
  id: ID!
  userId: ID!
  title: String!
  text: String!
  targetTypes: [TargetType!]!
  systemOwned: Boolean!
  createdAt: Time!
  updatedAt: Time!
}

input CreateFlowTemplateInput {
  title: String!
  text: String!
  targetTypes: [TargetType!]
}

input UpdateFlowTemplateInput {
  title: String!
  text: String!
}

# ==================== Domain Orchestration Types ====================

# Lifecycle status of a domain-orchestrated scan
enum DomainStatusType {
  created
  classifying
  running
  waiting
  finished
  failed
}

# A target (e.g. acme.com) that groups one or more child Flows
type Domain {
  id: ID!
  name: String!
  targetType: TargetType!
  status: DomainStatusType!
  # Engagement posture (new scan wizard). Null for classic domains/scans.
  scope: ScanScope
  box: ScanBox
  # Raw recon/classification output as a JSON string ("{}" when not auto-detected)
  detectionMetadata: String!
  createdAt: Time!
  updatedAt: Time!
  flows: [Flow!]!
}

input CreateDomainInput {
  name: String!
  # Required when autoDetect is false; ignored (and overwritten) when autoDetect is true
  targetType: TargetType
  # Templates to spawn now (manual path); may be empty when autoDetect picks defaults
  templateIds: [ID!]!
  # When true, run recon + classifier to detect targetType and pick default templates
  autoDetect: Boolean
  # Optional; when omitted the backend resolves the user's default provider.
  modelProvider: String
}

# ==================== Scan Engagement Types (new wizard) ====================

# Cloud engagement scope: internal (agent uses an account) vs external (outside attacker).
enum ScanScope {
  internal
  external
}

# Web engagement posture: grey box (credentials provided) vs black box (none).
enum ScanBox {
  grey
  black
}

# How each selected template runs.
enum ScanRunMode {
  automatic
  assistant
}

# Kind of target credential supplied for an authenticated engagement.
enum ScanCredentialKind {
  web_token
  email_password
  cloud_keys
}

# Target credentials for an authenticated engagement. The value is the secret
# payload (a token, a JSON {email,password}, or a cloud service-account key JSON).
# It is encrypted at rest and only collected for internal (cloud) / grey-box (web)
# engagements; ignored for external/black-box.
input ScanCredentialInput {
  kind: ScanCredentialKind!
  value: String!
}

# A selected template plus the mode it should run in.
input ScanTemplateInput {
  templateId: ID!
  runMode: ScanRunMode!
}

input CreateScanInput {
  name: String!
  targetType: TargetType!
  # Cloud engagements set scope; web engagements set box. Drives whether credentials are used.
  scope: ScanScope
  box: ScanBox
  templates: [ScanTemplateInput!]!
  # Only used for internal (cloud) / grey-box (web); ignored otherwise.
  credential: ScanCredentialInput
  # Optional; when omitted the backend resolves the user's default provider.
  modelProvider: String
}

# Live per-user quota usage powering the spawn confirmation screen
type QuotaUsage {
  flowsCurrent: Int!
  flowsMax: Int!
  domainsCurrent: Int!
  domainsMax: Int!
  flowsPerDomainMax: Int!
}

# ==================== Flow Management Types ====================

type Terminal {
  id: ID!
  type: TerminalType!
  name: String!
  image: String!
  connected: Boolean!
  createdAt: Time!
}

type Assistant {
  id: ID!
  title: String!
  status: StatusType!
  provider: Provider!
  flowId: ID!
  useAgents: Boolean!
  createdAt: Time!
  updatedAt: Time!
  findings: [Finding!]!
}

type FlowAssistant {
  flow: Flow!
  assistant: Assistant!
}

# Technical risk rating for a structured security finding, aligned to CVSS v3.1
enum Severity {
  critical
  high
  medium
  low
  informational
}

# A single structured security finding extracted by the reporter agent. Drives the
# report's finding cards and severity summary. String fields are plain prose.
type Finding {
  taskId: ID!
  # Position within the source findings array. Display order is sorted by severity, so
  # this — not the list position — is what identifies a finding for editing.
  index: Int!
  title: String!
  severity: Severity!
  # True when an analyst re-rated this finding; originalSeverity is what the model assessed.
  severityUpdated: Boolean!
  originalSeverity: Severity
  originalCvss: Float
  cvss: Float
  cve: String
  affectedUrls: [String!]
  description: String
  evidence: String
  impact: [String!]
  stepsToReproduce: [String!]
  recommendation: String
  references: [String!]
}

type Flow {
  id: ID!
  title: String!
  status: StatusType!
  terminals: [Terminal!]
  provider: Provider!
  createdAt: Time!
  updatedAt: Time!
  findings: [Finding!]!
}

type Task {
  id: ID!
  title: String!
  status: StatusType!
  input: String!
  result: String!
  flowId: ID!
  subtasks: [Subtask!]
  createdAt: Time!
  updatedAt: Time!
}

type Subtask {
  id: ID!
  status: StatusType!
  title: String!
  description: String!
  result: String!
  taskId: ID!
  createdAt: Time!
  updatedAt: Time!
}

